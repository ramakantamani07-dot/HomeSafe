# Copy this file to .env and fill in the values you need.
# Never commit .env — it is gitignored.
#
# The app runs entirely on mock data with NONE of these set. Add credentials
# only when you are ready to move a given capability to its real backend.
# See docs/reference/RUNNING.md.

# ─── Data source ─────────────────────────────────────────────────────────────
# auto (default) · real when Firebase credentials are present, mock otherwise
# mock           · always mock, even with credentials configured
# real           · always real; fails loudly at startup if credentials are
#                  missing, instead of silently falling back to mocks
EXPO_PUBLIC_DATA_SOURCE=auto

# ─── Firebase ────────────────────────────────────────────────────────────────
# From Firebase console → Project settings → Your apps → SDK setup.
# All four of API_KEY, AUTH_DOMAIN, PROJECT_ID and APP_ID are required before
# the app considers Firebase "configured"; partial values keep it on mocks.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ─── Apple (iOS builds) ──────────────────────────────────────────────────────
# ─── App identity ────────────────────────────────────────────────────────────
# Overrides the iOS bundle identifier and Android package name. Optional — the
# default in app.config.ts works. Set this only when building against a
# different Apple account, or for a side-by-side variant on one device.
# Apple's identifier namespace is global, so whatever you pick must be unique
# across every developer account, not just yours.
# APP_BUNDLE_ID=

# Only needed for the SOS Lock Screen widget target. Without it the app builds
# and runs normally, just without that widget. Xcode → Signing & Capabilities,
# or developer.apple.com → Membership.
APPLE_TEAM_ID=

# ─── Google Maps (Android only) ──────────────────────────────────────────────
# iOS uses Apple Maps and needs no key. Android has no keyless provider, so the
# map renders as a blank grid without this. Baked in at prebuild time.
GOOGLE_MAPS_API_KEY=

# ─── Google Places (optional) ────────────────────────────────────────────────
# Needs "Places API (New)" + "Geocoding API" enabled. Without it, address
# search falls back to fixture data and the whole journey flow still works.
# This ships in the JS bundle — restrict it by bundle id / package name + API
# in the Google Cloud Console. An unrestricted key is a billing incident.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=

# ─── Routing (optional) ──────────────────────────────────────────────────────
# Defaults to the public OSRM demo server, which is rate-limited and not
# suitable for production traffic.
EXPO_PUBLIC_OSRM_BASE_URL=

# The EAS project ID is not a secret and is hardcoded in app.config.ts —
# eas-cli cannot write to a dynamic config file, so it must be a literal there.
