# Continuous native generation (app.config.ts is the source of truth) —
# these are regenerated by `expo prebuild` / EAS Build's own remote prebuild.
# Committing them risks drift from app.config.ts if someone hand-edits native
# files instead of the config plugin that's supposed to own them.
/ios/
/android/
functions/lib/
.DS_Store
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log
# Every env variant, not just the two that existed when this was written.
# .env.real.bak held real Firebase credentials and was matched by neither —
# one `git add .` away from being committed.
.env
.env.*
!.env.example
*.env.bak
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
npm-debug.*
yarn-debug.*
yarn-error.*
