    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "19.3.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "~54.0.10",
    "firebase-tools": "^15.30.0",
    "jest-expo": "^54.0.17",
    "typescript": "^5.3.3"
  },
  "expo": {
    "autolinking": {
      "ios": {
        "exclude": [
          "expo-firebase-core"
        ]
      }
