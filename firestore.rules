rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ─────────────────────────────────────────────────────────────

    // Only the user whose uid matches the path segment may access their data.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Incoming document must have a specific field equal to value.
    function incomingHasField(field, value) {
      return request.resource.data[field] == value;
    }

    // Field must be unchanged between the existing document and the incoming write.
    // Only valid in update rules (where resource.data exists).
    function fieldUnchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // Fetches a familyConnections document's data by ID.
    function connectionData(connectionId) {
      return get(/databases/$(database)/documents/familyConnections/$(connectionId)).data;
    }

    // True if uid is one of the two members of this connection (any status).
    function isConnectionMember(connectionId, uid) {
      let c = connectionData(connectionId);
      return c.user1Id == uid || c.user2Id == uid;
    }

    // True if uid is a member of this connection AND the connection is ACTIVE.
    function isActiveConnectionMember(connectionId, uid) {
      let c = connectionData(connectionId);
      return c.status == 'ACTIVE' && (c.user1Id == uid || c.user2Id == uid);
    }

    // Cheap shape guard against garbage/oversized fields from a compromised or
    // buggy client. Not a substitute for app-level validation — just a floor.
    function isReasonableString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    // A journey's nextCheckInAt is computed and written entirely client-side
    // (CheckInService.confirmSafe/extendCheckIn) — nothing previously stopped
    // a buggy or compromised client from writing an arbitrary future value to
    // suppress detectMissedCheckIns indefinitely. Bounded to the app's own
    // longest real interval/extend option (60 min — CHECK_IN_INTERVAL_OPTIONS
    // and EXTEND_OPTIONS_MINUTES in src/models/CheckIn.ts) plus a 5-minute
    // buffer for latency/clock skew. null is always valid — it means no
    // check-in scheduled (missed/cancelled/completed journeys clear it).
    function isValidNextCheckIn(value) {
      return value == null
        || (value is timestamp
            && value >= request.time
            && value <= request.time + duration.value(65, 'm'));
    }

    // ─── Family Invitations ──────────────────────────────────────────────────
    // Root-level collection. Sender creates; recipient reads/accepts by phone JWT.
    match /familyInvitations/{invitationId} {
      allow create: if request.auth != null
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.status == 'PENDING';

      allow read: if request.auth != null && (
        // Sender can always see their own invitation
        resource.data.fromUserId == request.auth.uid
        // Recipient identified by their phone number claim in the JWT
        || resource.data.toPhone == request.auth.token.phone_number
      );

      allow update: if request.auth != null && (
        // Sender can cancel
        resource.data.fromUserId == request.auth.uid
        // Recipient can accept or decline
        || resource.data.toPhone == request.auth.token.phone_number
      )
      // Only the status field may change; all identity fields are immutable
      && fieldUnchanged('fromUserId')
      && fieldUnchanged('fromPhone')
      && fieldUnchanged('toPhone');

      allow delete: if request.auth != null
        && resource.data.fromUserId == request.auth.uid;
    }

    // ─── Family Connections ──────────────────────────────────────────────────
    // Peer-to-peer connections. Document ID = min(uid1, uid2) + '_' + max(uid1, uid2).
    match /familyConnections/{connectionId} {
      allow read: if request.auth != null && (
        resource.data.user1Id == request.auth.uid
        || resource.data.user2Id == request.auth.uid
      );

      allow create: if request.auth != null && (
        request.resource.data.user1Id == request.auth.uid
        || request.resource.data.user2Id == request.auth.uid
      )
      // Initiator must be one of the two users
      && (
        request.resource.data.initiatedBy == request.auth.uid
      );

      allow update: if request.auth != null && (
        resource.data.user1Id == request.auth.uid
        || resource.data.user2Id == request.auth.uid
      )
      // Core identity fields are immutable after creation
      && fieldUnchanged('user1Id')
      && fieldUnchanged('user2Id')
      && fieldUnchanged('initiatedBy')
      && fieldUnchanged('createdAt')
      // Each side may only rewrite its own outbound permissions — otherwise
      // either party could grant themselves more visibility into the other
      // person's data than that person configured.
      && (fieldUnchanged('user1Permissions') || request.auth.uid == resource.data.user1Id)
      && (fieldUnchanged('user2Permissions') || request.auth.uid == resource.data.user2Id);

      allow delete: if false; // Status is set to CANCELLED instead of deleting

      // ── Shared status ─────────────────────────────────────────────────────
      // One doc per publisher, already filtered to exactly what that publisher's
      // outbound permissions allow this connection to see (see
      // FamilyService.publishStatus / deriveSharedView). Because the content is
      // pre-filtered at write time, the read rule only needs to check connection
      // membership — there is no sharingMode/shareBattery/etc. logic to get
      // wrong here, unlike the old single global users/{uid}/familyStatus doc.
      match /sharedStatus/{publisherUserId} {
        allow read: if request.auth != null && (
          request.auth.uid == publisherUserId
          || isActiveConnectionMember(connectionId, request.auth.uid)
        );
        allow write: if request.auth != null
          && request.auth.uid == publisherUserId
          && isConnectionMember(connectionId, publisherUserId);
      }

      // ── Watch presence (Phase 5b, S2c) ────────────────────────────────────
      // "Mum is watching": one doc per watcher, written only by that watcher,
      // readable by the connection. Courtesy, not enforcement — reading
      // sharedStatus does not require announcing — but nobody can announce on
      // someone else's behalf, or name a stranger as the one watching.
      match /watchers/{watcherId} {
        allow read: if request.auth != null
          && isActiveConnectionMember(connectionId, request.auth.uid);
        allow create, update: if request.auth != null
          && request.auth.uid == watcherId
          && isActiveConnectionMember(connectionId, watcherId)
          && request.resource.data.keys().hasOnly(['watcherId', 'name', 'watching', 'until'])
          && request.resource.data.watcherId == watcherId
          && request.resource.data.watching != watcherId
          && isActiveConnectionMember(connectionId, request.resource.data.watching)
          && request.resource.data.name is string
          && request.resource.data.until is timestamp;
        allow delete: if request.auth != null && request.auth.uid == watcherId;
      }
    }

    // ─── Journey Shares ─────────────────────────────────────────────────────
    // Public, read-only tracking links for a guardian without the app (see
    // models/JourneyShare.ts). The anonymous public read never touches
    // Firestore directly — it goes through the getSharedJourney Cloud
    // Function (Admin SDK, bypasses these rules entirely, and is the only
    // path that checks the linked journey's live status). These rules only
    // govern the authenticated owner creating/reading/deleting their own
    // share links from within the app.
    match /journeyShares/{shareId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && isReasonableString(request.resource.data.journeyId, 200)
        && isReasonableString(request.resource.data.displayName, 100);
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if false; // immutable once created — create a new share instead
    }

    // ─── Users ───────────────────────────────────────────────────────────────
    // Stores: fcmToken (written by NotificationService on every sign-in)
    // User profile (name, phone, settings) is stored in SecureStore, NOT Firestore.
    match /users/{userId} {
      allow read:   if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // ── Contacts ───────────────────────────────────────────────────────────
      // Stores: name, phone, relationship, createdAt, updatedAt
      match /contacts/{contactId} {
        allow read:   if isOwner(userId);
        allow create: if isOwner(userId)
          && isReasonableString(request.resource.data.get('name', ''), 100)
          && isReasonableString(request.resource.data.get('phone', ''), 20);
        allow update: if isOwner(userId)
          // Contact creation timestamp is immutable after first write.
          && fieldUnchanged('createdAt')
          && isReasonableString(request.resource.data.get('name', ''), 100)
          && isReasonableString(request.resource.data.get('phone', ''), 20);
        allow delete: if isOwner(userId);
      }

      // ── Journeys ───────────────────────────────────────────────────────────
      // Stores: userId, status, destinationLabel, startLocation, currentLocation, …
      match /journeys/{journeyId} {
        allow read:   if isOwner(userId);
        allow create: if isOwner(userId)
          // userId field in the document must match the path — prevents spoofing.
          && incomingHasField('userId', userId)
          && isReasonableString(request.resource.data.get('destinationLabel', ''), 200);
        allow update: if isOwner(userId)
          // Ownership and creation time are immutable after the first write.
          && fieldUnchanged('userId')
          && fieldUnchanged('createdAt')
          && (fieldUnchanged('nextCheckInAt')
              || isValidNextCheckIn(request.resource.data.get('nextCheckInAt', null)));
        allow delete: if isOwner(userId);

        // ── Location Updates ──────────────────────────────────────────────
        // Raw GPS trail. Append-only (update is never needed after creation).
        match /locationUpdates/{updateId} {
          allow read:   if isOwner(userId);
          allow create: if isOwner(userId);
          // Location records are immutable — edits are never issued by the app.
          allow update: if false;
          // Blocked while this journey has an active SOS: the GPS trail is
          // the evidence an emergency alert points contacts to, and the owner
          // (or a compromised client) must not be able to erase it mid-emergency.
          allow delete: if isOwner(userId)
            && get(/databases/$(database)/documents/users/$(userId)/journeys/$(journeyId)).data.status != 'SOS_TRIGGERED';
        }

        // ── Check-ins ──────────────────────────────────────────────────────
        // Stores: journeyId, scheduledAt, status, createdAt, …
        match /checkIns/{checkInId} {
          allow read:   if isOwner(userId);
          allow create: if isOwner(userId);
          allow update: if isOwner(userId)
            && fieldUnchanged('createdAt');
          allow delete: if isOwner(userId);
        }

        // ── Safety checks ──────────────────────────────────────────────────
        // The automatic "are you OK?" (screen 08). Stores: reason, status,
        // raisedAt, respondedAt, escalatedAt, location, batteryPercent.
        //
        // An ESCALATED record is what tells the Cloud Function to alert the
        // guardians, so it is deliberately a one-way door: once escalated, the
        // client can no longer edit or delete it. Otherwise a coerced or
        // compromised device could walk back an alert that has already gone
        // out — the exact scenario this feature exists for.
        match /safetyChecks/{safetyCheckId} {
          allow read:   if isOwner(userId);
          // `escalateAt` is required: it is the only thing the server-side
          // backstop can act on, so a check raised without one would be
          // invisible to escalation if the client then died.
          allow create: if isOwner(userId)
            && incomingHasField('status', 'PENDING')
            && incomingHasField('journeyId', journeyId)
            && request.resource.data.escalateAt is timestamp;
          // escalateAt is the deadline the server enforces. A client that
          // could push it back could silence its own alert indefinitely, which
          // is precisely the coercion case this feature exists for — so it is
          // immutable from the moment the check is raised.
          allow update: if isOwner(userId)
            && resource.data.status != 'ESCALATED'
            && fieldUnchanged('journeyId')
            && fieldUnchanged('raisedAt')
            && fieldUnchanged('reason')
            && fieldUnchanged('escalateAt');
          allow delete: if isOwner(userId)
            && resource.data.status != 'ESCALATED';
        }
      }

      // ── Saved Places ───────────────────────────────────────────────────────
      // Stores: name, kind, address {…}, arrivalRadiusMeters, createdAt.
      // Owner-only in both directions: a saved place is a home address, and
      // nothing outside the owner's own session ever needs to read one. What
      // guardians see during a journey is the destination *name*, carried on
      // the journey document, never this list.
      match /savedPlaces/{savedPlaceId} {
        allow read:   if isOwner(userId);
        allow create: if isOwner(userId)
          && isReasonableString(request.resource.data.get('name', ''), 100);
        allow update: if isOwner(userId)
          && fieldUnchanged('createdAt')
          && isReasonableString(request.resource.data.get('name', ''), 100);
        allow delete: if isOwner(userId);
      }

      // ── Walk feedback ──────────────────────────────────────────────────────
      // How a journey felt: Fine / Uneasy / Unsafe (Option 15 `AI6`).
      //
      // Owner-only in both directions, and deliberately NOT reachable from the
      // familyConnections path that guardians read. The spec requires this —
      // "do not share it with guardians" — and it is a correctness property,
      // not a preference: someone who felt unsafe on a route their parent
      // chose has to be able to say so without that parent reading it, or the
      // answers stop being honest and the data is worthless.
      //
      // Immutable timestamp so a rating cannot be backdated; the rating itself
      // may be changed by its owner, since changing your mind about how
      // something felt is legitimate.
      match /walkFeedback/{journeyId} {
        allow read:   if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.journeyId == journeyId
          && request.resource.data.rating in ['fine', 'uneasy', 'unsafe'];
        allow update: if isOwner(userId)
          && fieldUnchanged('journeyId')
          && request.resource.data.rating in ['fine', 'uneasy', 'unsafe'];
        allow delete: if isOwner(userId);
      }

      // ── Basic-phone members ────────────────────────────────────────────────
      // Someone in the circle with no smartphone and no account. Owned by the
      // guardian who added them; nobody else can see or touch the record.
      //
      // consentStatus is mirrored here so the circle list reads one document,
      // but it is NOT authoritative — the consent document is, and the rules
      // below are what protect it. A client that lied here would mislead its own
      // list and change nothing about whether a lookup is permitted.
      match /basicPhoneMembers/{memberId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.phoneNumber is string
          && request.resource.data.displayName is string;
        allow update: if isOwner(userId)
          // Consent is granted for a specific number. Letting the number change
          // under an existing consent would silently transfer permission to
          // whoever holds the new SIM.
          && fieldUnchanged('phoneNumber');
        allow delete: if isOwner(userId);
      }

      // ── Consent ────────────────────────────────────────────────────────────
      // THE security boundary for network location. Whether one person may see
      // another person's location is decided entirely by this document.
      //
      // **A client may reach exactly two states: PENDING_SMS and REVOKED.**
      //
      //   PENDING_SMS  asking is something a guardian may do
      //   REVOKED      stopping must always work, immediately, from any state
      //
      // Everything between — SMS_APPROVED, OPERATOR_PENDING, ACTIVE, DECLINED,
      // EXPIRED — is writable only by a Cloud Function, which reaches Firestore
      // through the Admin SDK and bypasses these rules. ACTIVE in particular
      // represents "the member texted YES *and* their operator authorised it",
      // and neither fact is one the requesting device is in any position to
      // assert about somebody else.
      //
      // Revocation is deliberately allowed client-side rather than routed
      // through a function: the spec requires STOP to work "any time", and
      // "stop sharing my location" must not depend on a backend being
      // reachable. Permission is the thing that should fail closed.
      match /consents/{memberId} {
        allow read: if isOwner(userId);

        // Only the client model's fields. The server keeps its own state on
        // this document — the rate-limit window, the transparency-SMS throttle,
        // delivery of the request — and a guardian able to pre-set those could,
        // say, stamp lastNoticeAt in 2099 and never have the member told they
        // were being located.
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
               'memberId', 'status', 'phoneNumber', 'requestedAt',
               'expiresAt', 'activatedAt', 'updatedAt'])
          && incomingHasField('status', 'PENDING_SMS')
          && request.resource.data.memberId == memberId
          && request.resource.data.phoneNumber is string
          && request.resource.data.expiresAt is timestamp;

        // The only transition a client may make.
        allow update: if isOwner(userId)
          && incomingHasField('status', 'REVOKED')
          && resource.data.status != 'REVOKED'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'updatedAt'])
          && fieldUnchanged('memberId')
          && fieldUnchanged('phoneNumber')
          && fieldUnchanged('requestedAt');

        // Never deleted. A consent record is the evidence that permission was
        // given or withdrawn, and evidence that can be erased proves nothing.
        allow delete: if false;
      }

      // ── Consent events ─────────────────────────────────────────────────────
      // Append-only audit of every transition (spec §4).
      //
      // The client may write only the revocation it is allowed to perform above,
      // so the two cannot disagree. Updates and deletes are refused outright:
      // a history that can be rewritten is not an audit trail.
      match /consentEvents/{eventId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && incomingHasField('to', 'REVOKED')
          && request.resource.data.memberId is string
          && request.resource.data.at is timestamp;
        allow update, delete: if false;
      }

      // ── Safe zones (Phase 6.5) ─────────────────────────────────────────────
      // A guardian's circles around places, for one of their basic-phone
      // members. The client writes the circle; the server writes what the
      // network says (state, pending readings, last checked) — a client able to
      // set `state` could fake an arrival, so those fields are refused here.
      // Radius bounds mirror ZONE_MIN/MAX_RADIUS_M: network location cannot
      // honestly answer for a circle smaller than its own accuracy.
      match /safeZones/{zoneId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['memberId', 'name', 'centre', 'radiusMeters', 'createdAt'])
          && exists(/databases/$(database)/documents/users/$(userId)/basicPhoneMembers/$(request.resource.data.memberId))
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40
          && request.resource.data.centre.latitude is number
          && request.resource.data.centre.longitude is number
          && request.resource.data.radiusMeters is number
          && request.resource.data.radiusMeters >= 500
          && request.resource.data.radiusMeters <= 5000
          && request.resource.data.createdAt is timestamp;
        allow update: if false;
        allow delete: if isOwner(userId);
      }

      // Arrivals and departures — server-written, append-only, owner-read.
      match /zoneEvents/{eventId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // SOS and check-ins sent by a basic-phone member, by text or missed call
      // (Phase 6.6). Server-written: a guardian's app must not be able to
      // invent an SOS, or erase one.
      match /memberEvents/{eventId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // ── Locate audits ──────────────────────────────────────────────────────
      // Every lookup attempt, including refused ones — an audit that recorded
      // only successes could not answer "did anyone try to find me without my
      // consent?", which is the question it exists for.
      //
      // Written exclusively by the Cloud Function that performs lookups: a
      // client that could write its own audit entries could also omit them.
      match /locateAudits/{auditId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // ── Uneasy events ──────────────────────────────────────────────────────
      // "Feeling uneasy?" (AI5). Owner-only, like walkFeedback and for the same
      // reason: these are notes about how someone felt, and a guardian able to
      // read them would change what people are willing to record.
      //
      // Append-only by design. An uneasy moment happened; letting it be edited
      // or removed would make the log worthless for the route-safety work it
      // exists to feed, and would let someone be pressured into erasing it.
      match /uneasyEvents/{eventId} {
        allow read:   if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.action in
               ['opened', 'called-guardian', 'fake-call', 'told-circle', 'dismissed'];
        allow update, delete: if false;
      }

      // ── SOS Events ─────────────────────────────────────────────────────────
      // Stores: userId, journeyId, location, status, triggeredAt, createdAt, …
      match /sosEvents/{sosId} {
        allow read:   if isOwner(userId);
        allow create: if isOwner(userId)
          // userId field must match the path — prevents spoofing.
          && incomingHasField('userId', userId)
          // SOS events must be created in the ACTIVE state.
          && incomingHasField('status', 'ACTIVE');
        allow update: if isOwner(userId)
          // Ownership, trigger timestamp, and creation time are all immutable.
          && fieldUnchanged('userId')
          && fieldUnchanged('triggeredAt')
          && fieldUnchanged('createdAt');
        allow delete: if isOwner(userId);
      }

      // ── Own Status ─────────────────────────────────────────────────────────
      // Owner's raw, unfiltered safety snapshot. Self-readable only — never
      // shared cross-user from here. What family connections can see instead
      // comes from familyConnections/{connectionId}/sharedStatus/{publisherId},
      // which holds a copy already filtered by the owner's own sharing
      // permissions (see FamilyService.publishStatus). Keeping this doc
      // owner-only means a bypass of the app's UI can, at worst, only let the
      // owner see more of their own data — never another user's.
      // Path: users/{userId}/familyStatus/current
      match /familyStatus/{doc} {
        allow read:   if isOwner(userId);
        allow write:  if isOwner(userId);
      }
    }
  }
}
