# Network location (Phase 6). Copy to functions/.env.local for the emulator.
# Everything defaults to OFF: unset means the feature is unavailable.

# Markets where basic-phone finding is switched on. Comma-separated: GB,IN
NETWORK_LOCATION_MARKETS=

# Which adapters to use. Only "mock" exists until G3 names the providers;
# anything else (including unset) makes every entry point refuse.
NETWORK_LOCATION_ADAPTER=

# Signing secret for the mock SMS webhook (header x-wayloc-signature,
# hex HMAC-SHA256 of the raw body). The webhook refuses all requests without it.
MOCK_SMS_WEBHOOK_SECRET=

# India only: TRAI DLT template ids, one per template. Unregistered = not sent.
DLT_TEMPLATE_CONSENT_REQUEST=
DLT_TEMPLATE_CONSENT_ACTIVE=
DLT_TEMPLATE_CONSENT_AMBIGUOUS=
DLT_TEMPLATE_CONSENT_HELP=
DLT_TEMPLATE_STOP_CONFIRMED=
DLT_TEMPLATE_GUARDIAN_STOPPED=
DLT_TEMPLATE_ZONE_CREATED=
DLT_TEMPLATE_TRANSPARENCY=
